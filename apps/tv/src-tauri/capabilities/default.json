{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: close itself and reach any Xtream panel or CDN over HTTP(S).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
