{
  "name": "@iptv/tv",
  "version": "1.0.0",
  "private": true,
  "description": "10-foot IPTV app for LG webOS, Samsung Tizen and desktop (Tauri), built with Vite + React.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && es-check es2019 'dist/assets/*.js'",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "package:webos": "node scripts/package-webos.mjs",
    "package:tizen": "node scripts/package-tizen.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-http": "^2.9.0",
    "core-js": "^3.51.0",
    "hls.js": "^1.6.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webos-tools/cli": "^3.2.6",
    "es-check": "^9.9.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  }
}
