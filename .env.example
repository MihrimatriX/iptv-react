# Optional server-side Xtream defaults. Leave empty to log in from the UI.
XTREAM_API_BASE=http://your-panel-host:8080/player_api.php
XTREAM_USERNAME=your_username_here
XTREAM_PASSWORD=your_password_here
XTREAM_SESSION_COOKIE=

# Lets the TV/desktop apps use this server as their proxy (Settings > Proxy).
# Packaged LG webOS apps are bound by CORS; set to * to allow them.
STREAM_PROXY_CORS_ORIGIN=
